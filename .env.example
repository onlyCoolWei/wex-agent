API_PORT=3001
VITE_API_URL=http://localhost:3001

# Supabase project URL from Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only key. Prefer the new sb_secret_... key. Never expose it to apps/web.
SUPABASE_SECRET_KEY=sb_secret_your-server-key

# Legacy projects may use this instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Later phases
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wex_agent
REDIS_URL=redis://localhost:6379
LITELLM_BASE_URL=http://localhost:4000
