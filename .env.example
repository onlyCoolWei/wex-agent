API_PORT=3001
VITE_API_URL=http://localhost:3001

# Shared Supabase project URL. Used by both the browser and server.
SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe key for Web Auth. Use the publishable key (or legacy anon key), never the server secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-browser-key

# Server-only key. Prefer the new sb_secret_... key. Never expose it to apps/web.
SUPABASE_SECRET_KEY=sb_secret_your-server-key

# Legacy projects may use this instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wex_agent
REDIS_URL=redis://localhost:6379

# Worker-only remote model gateway and Langfuse observability credentials.
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=sk-your-litellm-virtual-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
