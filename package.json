{
  "name": "wex-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript monorepo for the Wex coding agent platform",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@wex/web --filter=@wex/api --filter=@wex/worker",
    "dev:web": "pnpm --filter @wex/web dev",
    "dev:api": "pnpm --filter @wex/api dev",
    "dev:worker": "pnpm --filter @wex/worker dev",
    "deps": "turbo ls",
    "graph": "turbo run build --graph=.turbo/build-graph.html",
    "plan": "turbo run build --dry-run=text",
    "check:docs": "node scripts/check-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^22.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "lint-staged": {
    "*.{cjs,css,html,js,json,jsonc,jsx,md,mjs,scss,ts,tsx,yaml,yml}": "prettier --write"
  }
}
