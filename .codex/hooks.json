{
  "description": "Update the project diary after Codex completes a task.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/summarize_to_diary.py\"",
            "timeout": 5,
            "statusMessage": "Checking project diary"
          }
        ]
      }
    ]
  }
}
